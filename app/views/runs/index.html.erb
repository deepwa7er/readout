<% content_for :title, "Readout — load test runs" %>

<header class="page-header">
  <h1>Readout</h1>
  <div class="actions" style="margin-top: 0">
    <%# Only where a runner is actually reachable: launching is meaningless on
        an instance that has neither k6 nor the results directory. %>
    <% if @runner_available %>
      <%= link_to "New load test", new_test_run_path, class: "button" %>
    <% end %>
    <% if @results_available %>
      <%= button_to "Rescan results", import_runs_path, class: "button button--secondary" %>
    <% end %>
  </div>
</header>

<% if @results_available %>
  <p class="meta">Campfire load tests · <%= @results_root %></p>
<% else %>
  <p class="meta">Campfire load tests · published snapshot</p>
<% end %>

<% if @active_test_id %>
  <%= render "test_runs/active_banner", test_id: @active_test_id %>
<% end %>

<% if @runs.empty? %>
  <p class="empty-state">
    <% if @results_available %>
      No runs imported yet. Run the harness, then rescan.
    <% else %>
      Nothing published yet. Run <code>bin/publish</code> on the machine that
      generates load.
    <% end %>
  </p>
<% else %>
  <ul class="runs">
    <% @runs.each do |run| %>
      <li class="run">
        <%= link_to run.stamp, run_path(run), class: "run-title" %>

        <p class="meta">
          <%= run.scenario.to_s.sub("scenarios/", "").presence || "unknown scenario" %>
          <% if run.peak_vus %>
            · peak <%= run.peak_vus %> vus
          <% end %>
          <% if run.peak_cpu_pct %>
            · cpu <%= run.peak_cpu_pct.round %>%
          <% end %>
          <% if run.started_at %>
            · <%= run.started_at.strftime("%b %-d %H:%M") %>
          <% end %>
        </p>

        <% narrative = RunNarrative.new(run) %>
        <p class="muted"><%= narrative.headline %></p>
      </li>
    <% end %>
  </ul>
<% end %>
