<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-preview">
<% end %>
<% content_for :title, "Readout — #{@run['id']}" %>

<%= link_to "← All runs", runs_path, class: "back-link" %>

<header class="page-header">
  <h1><%= @run["id"] %></h1>
</header>

<p class="meta">
  <%= @run["scenario"] %>
  <% if @run["note"].present? %> · <%= @run["note"] %><% end %>
</p>

<h2>Settings</h2>

<%= render "shared/settings", settings: @run["levers"].to_h %>

<%# The charts sit OUTSIDE the Turbo Frame below: the frame swaps its contents
    every couple of seconds, and a canvas rebuilt that often flickers. %>
<%= render "shared/coping_charts",
      progress_url: progress_test_run_path(@run["id"], format: :json),
      live: true %>

<%# Status and the stop button only. Everything else that used to live here has
    been removed deliberately. %>
<%= turbo_frame_tag "run-status", src: status_test_run_path(@run["id"]), loading: :eager do %>
  <p class="muted">Loading…</p>
<% end %>
