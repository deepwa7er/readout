<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-preview">
<% end %>
<% content_for :title, "Readout — #{@run['id']}" %>

<%= link_to "← All runs", runs_path, class: "back-link" %>

<header class="page-header">
  <h1><%= @run["id"] %></h1>
</header>

<p class="meta">
  <%= @run["scenario"] %>
  <% if @run["note"].present? %> · <%= @run["note"] %><% end %>
</p>

<h2>Settings</h2>

<dl class="settings">
  <% if @run["levers"].blank? %>
    <div>
      <dt>defaults</dt>
      <dd>nothing overridden</dd>
    </div>
  <% end %>
  <% @run["levers"].to_h.each do |key, value| %>
    <div>
      <dt><%= lever_label(key) %></dt>
      <dd><%= value %></dd>
    </div>
  <% end %>
</dl>

<%# Two charts, deliberately separate. They answer different questions and have
    different units, and stacking both onto one set of axes made neither
    readable. Both sit OUTSIDE the Turbo Frame: the frame swaps its contents
    every couple of seconds, and a canvas rebuilt that often flickers. %>

<h2>How long a message takes to arrive</h2>

<div data-controller="coping-chart"
     data-coping-chart-series-value="latency"
     data-coping-chart-url-value="<%= progress_test_run_path(@run["id"], format: :json) %>">
  <p class="meta" data-coping-chart-target="readout">—</p>
  <div class="chart-frame">
    <canvas data-coping-chart-target="canvas"></canvas>
  </div>
</div>

<p class="finding-body measure muted">
  Time between someone sending a message and it appearing on another person's
  screen. <strong>This is the number that decides whether a room is usable</strong> —
  a server can deliver almost every message and still be seconds behind.
  <span style="color: var(--good); font-weight: 600">Green</span> is under a
  second, which feels immediate;
  <span style="color: var(--danger); font-weight: 600">red</span> is above it,
  where the conversation stops feeling live.
</p>

<h2>Messages delivered per second</h2>

<div data-controller="coping-chart"
     data-coping-chart-url-value="<%= progress_test_run_path(@run["id"], format: :json) %>">
  <p class="meta" data-coping-chart-target="readout">—</p>
  <div class="chart-frame">
    <canvas data-coping-chart-target="canvas"></canvas>
  </div>
  <p class="finding-body measure figure--bad"
     data-coping-chart-target="warning" hidden></p>
</div>

<p class="finding-body measure muted">
  The <strong>solid line</strong> is how many messages the server delivered each
  second. The <strong>dashed line</strong> is how many it owed — every message
  someone sent, times the number of people who had to receive it.
  <span style="color: var(--good); font-weight: 600">Green</span> is keeping up,
  <span style="color: var(--danger); font-weight: 600">red</span> is falling
  behind. Sending one message to a room of 100 people is 100 deliveries, which is
  why this climbs so steeply with room size.
</p>

<%# Status and the stop button only. Everything else that used to live here has
    been removed deliberately. %>
<%= turbo_frame_tag "run-status", src: status_test_run_path(@run["id"]), loading: :eager do %>
  <p class="muted">Loading…</p>
<% end %>
